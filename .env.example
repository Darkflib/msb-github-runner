# Org name ("my-org") for org-level runners, or "owner/repo" for one repository.
GITHUB_TARGET=my-org

# --- Auth: pick ONE ---
# GitHub App (recommended): org permission "Self-hosted runners: read & write"
# (or repo permission "Administration: read & write" for a repo target).
GITHUB_APP_ID=
GITHUB_APP_KEY_FILE=/secrets/app.pem
# GITHUB_APP_INSTALLATION_ID=   # auto-discovered if empty
# Fine-grained PAT with the same permission:
# GITHUB_TOKEN=

# --- Pool ---
POOL_SIZE=2
RUNNER_PREFIX=msb-test-vx1          # unique per host; used to clean up stale runners
# RUNNER_LABELS=self-hosted,linux,x64,msb
# RUNNER_GROUP_ID=1                 # 1 = Default group
# RUNNER_IMAGE=ghcr.io/actions/actions-runner:latest

# --- Per-VM resources ---
VM_CPUS=2
VM_MEMORY=4G
JOB_MAX_DURATION=6h
ENABLE_DOCKER=1                     # start dockerd inside each VM

# Default: public internet only, LAN and 169.254.169.254 blocked.
# MSB_NET_ARGS=--net public --net-rule deny@169.254.169.254
# MSB_EXTRA_ARGS=
